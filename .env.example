# 数据源：mock（本地假数据）| api（Supabase：Auth / profiles / topics / bookmarks）
NEXT_PUBLIC_DATA_SOURCE=api

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Optional: server-only keys（勿加 NEXT_PUBLIC_，不要提交真实值）
# Supabase Secret / service_role — 仅本地 seed 脚本写库用
# SUPABASE_SECRET_KEY=sb_secret_...
# SUPABASE_SERVICE_ROLE_KEY=eyJ...   # Legacy 名称，二选一即可

# AI provider（默认 gemini；可设 AI_PROVIDER=openai）
# AI_PROVIDER=gemini
# GEMINI_API_KEY=your-gemini-api-key
# 可选：GEMINI_MODEL=gemini-2.0-flash；LLM_TIMEOUT_MS=12000
# Embedding：默认 gemini-embedding-001 @ 768 维（须与 SQL vector(768) 一致）
# EMBEDDING_MODEL=gemini-embedding-001
# EMBEDDING_DIMENSIONS=768
# 推荐 Context：有 GEMINI_API_KEY 时 parseDemandContextWithLLM；失败 → 规则版
# 强制只用规则：RECOMMEND_LLM_CONTEXT=0
# 手改 themes/keywords/preferences/goal/depth/session_bucket 优先于 AI 解析
#
# 可选 OpenAI 后端：AI_PROVIDER=openai + OPENAI_API_KEY
# （OpenAI embedding 默认 1536，须另改 SQL vector(N)，勿与 Gemini 768 混用）
#
# 启用语义召回：执行 supabase/patch_works_embedding.sql（或已有 1536 列则跑 patch_works_embedding_gemini_768.sql）
# enrichment 新列：执行 supabase/patch_works_enrichment_fields.sql（primary_topics / concepts）
# 全量校正（规则 topics + LLM primary/concepts）并 force 重写 embedding：
#   npm run enrich:works -- --limit 10 --skip-embed   # 先抽样验收
#   npm run enrich:works
# 仅规则、不用 LLM：npm run enrich:works -- --rules-only --skip-embed
# 仅补 NULL embedding：npm run embed:works
# 强制覆盖已有 embedding：npm run embed:works -- --force
# 只 enrichment 不 embed：npm run enrich:works -- --skip-embed
#
# Google Books API — https://developers.google.com/books/docs/v1/using
# GOOGLE_BOOKS_API_KEY=your-google-books-api-key
# 推荐 API：本地候选不足时用同一 key 调 ingestBooks() 补库（需登录可写 works）
# 国内无法直连外网时，给 seed / Gemini fetch 配本地代理，例如：
# HTTP_PROXY=http://127.0.0.1:15236
# HTTPS_PROXY=http://127.0.0.1:15236
# （lib/server/proxy-fetch.ts 会让 LLM + embedding 走同一代理）
#
# 书目：先执行 supabase/migrate_works_editions.sql（或已有表则补 patch_works_topic_sources.sql）
# 清库重灌：SQL 执行 supabase/clear_catalog.sql
# 再：npm run seed:books -- --tags 游戏设计,美术,编程,人工智能,叙事 --per-tag 12
# 推荐流水线：lib/data/recommend/*（LLM/规则 Context → hybrid recall → 本地评分 → 不足补库）
